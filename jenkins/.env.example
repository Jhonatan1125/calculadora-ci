# Credenciales iniciales del panel de administracion de Jenkins (JCasC)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambiar_esta_clave
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000

# En Linux / GitHub Codespaces: GID de /var/run/docker.sock y URL externa del puerto 8080
DOCKER_GID=0
JENKINS_EXTERNAL_URL=http://localhost:8080/
