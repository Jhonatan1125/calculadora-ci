# Configuracion de puertos y comunicacion entre servicios en la red de Docker
APP_PORT=8000
HISTORIAL_PORT=5001
HISTORIAL_SERVICE_URL=http://historial-api:5001
HISTORIAL_DATA_FILE=/data/historial.json

# Secreto compartido entre calculadora-api e historial-api (reemplazar en .env local)
HISTORIAL_API_KEY=cambiar_este_secreto_en_env_local
